# GW config for web dashboard
# This is an explicit allowlist to allow the web dashboard to look at a handful of PVS ie. some blockserver, some DAE and some INSTETC. 

EVALUATION ORDER DENY, ALLOW

.* DENY


# Beam currents/instlists
AC:TS1:BEAM:CURR ALLOW
AC:TS2:BEAM:CURR ALLOW
AC:MUON:BEAM:CURR ALLOW
CS:INSTLIST  ALLOW 

# These are blocks for instruments and developer machines
[^:]+:[^:]+:CS:SB:.*  ALLOW 

# These are dashboard PVs for instruments and developer machines
[^:]+:[^:]+:CS:DASHBOARD:.*  ALLOW 

# Shutter statuses
[^:]+:[^:]+:CS:SHUTTER  ALLOW 

# Time of day
[^:]+:[^:]+:TIME_OF_DAY  ALLOW 

# blockserver config details
[^:]+:[^:]+:CS:BLOCKSERVER:WD_CONF_DETAILS  ALLOW 

# current config name

[^:]+:[^:]+:CS:BLOCKSERVER:CURR_CONFIG_NAME  ALLOW 

# DAE PVs

[^:]+:[^:]+:DAE:RUNSTATE_STR  ALLOW 
[^:]+:[^:]+:DAE:RUNNUMBER  ALLOW 
[^:]+:[^:]+:DAE:GOODFRAMES  ALLOW 
[^:]+:[^:]+:DAE:RAWFRAMES  ALLOW 
[^:]+:[^:]+:DAE:COUNTRATE  ALLOW 
[^:]+:[^:]+:DAE:_RBNUMBER  ALLOW 
[^:]+:[^:]+:DAE:BEAMCURRENT  ALLOW 
[^:]+:[^:]+:DAE:TOTALUAMPS  ALLOW 
[^:]+:[^:]+:DAE:MONITORCOUNTS  ALLOW 
[^:]+:[^:]+:DAE:MONITORSPECTRUM  ALLOW 
[^:]+:[^:]+:DAE:MONITORTO  ALLOW 
[^:]+:[^:]+:DAE:MONITORFROM  ALLOW 
[^:]+:[^:]+:DAE:NUMSPECTRA  ALLOW 
[^:]+:[^:]+:DAE:NUMTIMECHANNELS  ALLOW 
[^:]+:[^:]+:DAE:SIM_MODE  ALLOW 
[^:]+:[^:]+:DAE:STARTTIME  ALLOW 
[^:]+:[^:]+:DAE:RUNDURATION_STR  ALLOW 
[^:]+:[^:]+:DAE:PERIOD  ALLOW 
[^:]+:[^:]+:DAE:RAWFRAMES_PD  ALLOW 
[^:]+:[^:]+:DAE:NUMPERIODS  ALLOW 
[^:]+:[^:]+:DAE:RUNDURATION_PD_STR  ALLOW 
[^:]+:[^:]+:DAE:PERIODSEQ  ALLOW 
[^:]+:[^:]+:DAE:GOODFRAMES_PD  ALLOW 
[^:]+:[^:]+:DAE:DAEMEMORYUSED  ALLOW 
[^:]+:[^:]+:DAE:DAETIMINGSOURCE  ALLOW 
[^:]+:[^:]+:DAE:EVENTS  ALLOW 

# These are sanitised PVs so they can be hidden at the isisdae level.
[^:]+:[^:]+:DAE:WDTITLE  ALLOW 
[^:]+:[^:]+:DAE:WDUSERS  ALLOW 

# Central accelerator PVs
AC:SYNCH:BEAM:CURR  ALLOW
AC:EPB1:BEAM:CURR  ALLOW
AC:IONS:BEAM:CURR  ALLOW
AC:RFQ:BEAM:CURR  ALLOW
AC:LINAC:BEAM:CURR  ALLOW
AC:INJ:EFF  ALLOW
AC:ACC:EFF  ALLOW
AC:EXT:EFF  ALLOW
AC:BEAM:ENERGY  ALLOW
AC:BUNCH:LEN  ALLOW
AC:EXTRACT:DELAY  ALLOW
AC:SYNCH:MODE  ALLOW
AC:SYNCH:FREQ  ALLOW
AC:SYNCH:GMS1  ALLOW
AC:SYNCH:GMS2  ALLOW
AC:TS1:BEAM:STAT  ALLOW
AC:TS1:FREQ  ALLOW
AC:TS1:BEAM:TOTAL  ALLOW
AC:TS1:BEAM:YEST  ALLOW
AC:TS1:BEAMON:TIME  ALLOW
AC:TS1:BEAMOFF:TIME  ALLOW
AC:TS2:BEAM:STAT  ALLOW
AC:TS2:FREQ  ALLOW
AC:TS2:BEAM:TOTAL  ALLOW
AC:TS2:BEAM:YEST  ALLOW
AC:TS2:BEAMON:TIME  ALLOW
AC:TS2:BEAMOFF:TIME  ALLOW
TG:TS1:MOD:METH:TEMP  ALLOW
TG:TS1:MOD:HDGN:TEMP  ALLOW
TG:TS1:MOD:METH:TRANS:WARN  ALLOW
TG:TS1:MOD:METH:TRANS:WARN:TIME  ALLOW
TG:TS2:DMOD:METH:TEMP  ALLOW
TG:TS2:CMOD:METH:TEMP  ALLOW
TG:TS2:CMOD:HDGN:TEMP  ALLOW
TG:TS2:DMOD:RTIME:DUR  ALLOW
TG:TS2:DMOD:RTLIM  ALLOW
TG:TS2:DMOD:BEAM  ALLOW
TG:TS2:DMOD:BEAM:LIM  ALLOW
TG:TS2:DMOD:CHRGCHNG:TIME  ALLOW
TG:TS2:DMOD:ANNPLOW:STAT  ALLOW
TG:TS2:DMOD:FILLMASS  ALLOW
BL:MUON:KICKR:STAT  ALLOW

# Shutter and VAT valve statuses
[^:]+:[^:]+:SHTR:STAT  ALLOW
[^:]+:[^:]+:SHTR:MODE  ALLOW
[^:]+:[^:]+:VAT:STAT  ALLOW
